{
    "compilerOptions": {
        "target": "es6",
        "allowJs": false,
        "outDir": "./src/build/",
        "rootDir": "..",
        "removeComments": true,
        "strict": false,
        "sourceMap": true,
        "noImplicitAny": false,
        "module": "Node16",
        "moduleResolution": "Node16",
        "resolveJsonModule": true,
        "strictNullChecks": false,
        "ignoreDeprecations": "5.0",
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "types": ["node"],
        "lib": [
            "dom",
            "es7"
        ]
    },
    "include": ["../types.d.ts"]
}